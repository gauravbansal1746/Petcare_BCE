# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Frontend origin(s) allowed for CORS (comma-separated)
ALLOWED_ORIGIN=https://your-frontend-domain.com

# JWT
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=1d

# Razorpay (TEST MODE)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Cloud MySQL (preferred names)
DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_USER=petcare_app
DB_PASSWORD=replace_me
DB_NAME=petcare
DB_CONNECTION_LIMIT=10

# Back-compat (optional) — supported but DB_* preferred
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=petcare

# Cloudinary (enable if set; otherwise local /public/uploads is used)
# Option A (recommended): single URL
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option B: split env vars
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Folder prefix in Cloudinary
CLOUDINARY_FOLDER=petcare

